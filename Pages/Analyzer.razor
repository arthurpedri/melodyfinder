@page "/analyzer"
@inject IJSRuntime JS
@implements IAsyncDisposable

<h1>Realtime Chroma Analyzer</h1>

<button @onclick="StartAnalyzer" class="generate-button">
    Start Microphone
</button>
<button @onclick="StopAnalyzer" class="show-button">
    Stop Microphone
</button>
<button @onclick="ResetAnalyzer" class="show-button">
    Reset Accumulated Chroma
</button>
<button @onclick="() => showDetails = !showDetails" class="generate-button">
    @(showDetails ? "Hide" : "Show") Audio Features
</button>



<div style="margin-top:20px">
@if (showDetails) 
{
    <p>RMS: @features.Rms</p>
    <p>ZCR: @features.Zcr</p>
    <p>Flatness: @features.Flatness</p>
    <p>Centroid: @features.Centroid</p>

    @foreach (var note in chroma)
    {
        <div style="margin-bottom:10px">

            <strong>@note.Note</strong>

            <div style="
                height:20px;
                width:@(note.Value * 300)px;
                background:limegreen;
                display:inline-block;
                margin-left:10px;
            ">
            </div>

            @note.Value.ToString("0.000")

        </div>
    }
}
    <h4>Top 7 Notes</h4>
    @foreach (var note in accumulatedChroma.OrderByDescending(n => n.Value).Take(7))
    {

            <span><strong>@note.Note</strong> (@note.Value.ToString("0.000"))  |  </span>

    }
    <hr />
    @foreach (var note in accumulatedChroma)
    {
        <div style="margin-bottom:10px">

            <strong>@note.Note</strong>

            <div style="
                height:20px;
                width:@(note.Value * 3)px;
                background:blue;
                display:inline-block;
                margin-left:10px;
            ">
            </div>

            @note.Value.ToString("0.000")

        </div>
    }


</div>

@code {
    private bool showDetails = false;
    private DotNetObjectReference<Analyzer>? objRef;

    private List<NoteStrength> chroma =
        new();

    private List<NoteStrength> accumulatedChroma =
        new();

    private AudioFeatures features =
        new(); 

    protected override void OnInitialized()
    {
        foreach (var note in new[]
        {
            "C","C#","D","D#","E","F",
            "F#","G","G#","A","A#","B"
        })
        {
            chroma.Add(new NoteStrength
            {
                Note = note,
                Value = 0
            });
            accumulatedChroma.Add(new NoteStrength
            {
                Note = note,
                Value = 0
            });
        }
    }

    public void ResetAnalyzer()
    {
        foreach (var note in accumulatedChroma)
        {
            note.Value = 0;
        }
        InvokeAsync(StateHasChanged);
    }

    async Task StartAnalyzer()
    {
        objRef = DotNetObjectReference.Create(this);

        await JS.InvokeVoidAsync(
            "audioAnalyzer.start",
            objRef
        );
    }

    async Task StopAnalyzer()
{
    await JS.InvokeVoidAsync(
        "audioAnalyzer.stop"
    );
}

    [JSInvokable]
    public void ReceiveChroma(
        List<NoteStrength> values)
    {
        chroma = values;

        // If chroma value is above a threshold, add to accumulatedChroma
        foreach (var note in chroma)
        {
            if (note.Value > 0.99)
            {
                var accNote = accumulatedChroma
                    .First(n => n.Note == note.Note);
                accNote.Value += note.Value;
            }
        }

        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void ReceiveFeatures(
        AudioFeatures features)
    {
        this.features = features;

        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void ReceiveTest(string text)
    {
        Console.WriteLine(text);
    }

    public async ValueTask DisposeAsync()
    {
        await StopAnalyzer();

        objRef?.Dispose();
    }

    public class NoteStrength
    {
        public string Note { get; set; } = "";
        public double Value { get; set; }
    }

    public class AudioFeatures
{
    public double Rms { get; set; }
    public double Zcr { get; set; }
    public double Centroid { get; set; }
    public double Flatness { get; set; }
    public double Rolloff { get; set; }

    public double[] Chroma { get; set; } =
        Array.Empty<double>();
}
}


<!--
RMS

Volume / signal energy.

Silence:

~0.001

Music:

0.01–0.2+
ZCR (Zero Crossing Rate)

Measures noisiness / high-frequency content.

High:

hiss,
noise,
percussion.

Low:

stable tones,
bass notes.

Very useful.

Spectral Centroid

"Brightness."

Low:

bass-heavy,
warm.

High:

bright,
cymbals,
hiss.

Spectral Flatness

VERY useful for your problem.

Measures:

noise-like vs tone-like

Low flatness:

musical tones,
harmonics.

High flatness:

white noise,
fans,
hiss.

This may become your best noise detector.
-->